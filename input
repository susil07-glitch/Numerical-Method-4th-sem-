import matplotlib.pyplot as plt
import numpy as np

equation = input("Enter the function of variable x using numpy syntax in python: ")


def f(x):
    try:
        return eval(equation)
    except(SyntaxError,NameError,ZeroDivisionError,TypeError):
        raise RuntimeError("Invalid Syntax")
    

a,b=map(float,input("Enter two initial guesses using space: ").split())
fa,fb = f(a),f(b)

if(fa*fb>0):
    print(f"No root lies between {a} and {b}")
    exit(0)

E=float(input("Enter tolerable error: "))
N=1000
itr=float(input("Enter maximum number of iterations: "))
m=[] #list of midpoints
while(itr<=N):
    c=(a+b)/2
    fc = f(c)
    if(fc==0):
        break
    elif fa*fc>0:
        a=c
        fa=fc
    else:
        b=c
        fb=fc
    error = abs(a-b)

    if error<E:
        break

    itr+=1
    m.append(c)

if(itr>N):
    print(f"Solution not achieved in {N} iterations")
else:
    print(f"Approx solution in {itr} iterations is {c}")
    M_np = np.array(m)
    Y_np=np.zeros_like(m)
    X = np.linspace(a-5,b+5,1000)
    plt.figure(figsize=(8,4))
    plt.plot(X,f(X),label="f(x)",color="red",linestyle="dotted")
    plt.axhline(0,label="x-axis",color="g")
    plt.axvline(0,label="y_axis",color="black")
    plt.grid(True)
    plt.legend(loc="upper right")
    plt.xlabel("X")
    plt.ylabel("Y")
    plt.scatter(M_np,Y_np,marker="X")
    for i,v in enumerate(M_np):
        plt.text(v,0,str(i+1))
    plt.scatter(M_np,f(M_np),color="purple")
    plt.show()
    