
def f(x):
    return x*x -4*x-10

a,b=-2,-1
fa,fb = f(a),f(b)

if(fa*fb>0):
    print(f"No root lies between {a} and {b}")
    exit(0)

E=1e-20
N=1000
itr=1
while(itr<=N):
    c=(a+b)/2
    fc = f(c)
    if(fc==0):
        break
    elif fa*fc>0:
        a=c
        fa=fc
    else:
        b=c
        fb=fc
    error = abs(a-b)
    print(f"Error {error}")

    if error<E:
        break

    itr+=1

if(itr>N):
    print(f"Solution not achieved in {N} iterations")
else:
    print(f"Approx solution in {itr} iterations is {c}")